generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WebsiteClass {
  NONE
  SOCIAL_ONLY
  DIRECTORY_ONLY
  PROPER
  PROPER_DEAD
}

enum WebsiteCheck {
  OK
  DEAD
  SKIPPED
  AMBIGUOUS
}

enum BizStatus {
  OPERATIONAL
  CLOSED_TEMPORARILY
  CLOSED_PERMANENTLY
  UNKNOWN
}

enum OutreachStatus {
  NEW
  SCREENED
  CONTACTED
  INTERESTED
  DEMO_SENT
  SOLD
  DEAD
  DO_NOT_CONTACT
}

enum DomainState {
  AVAILABLE
  TAKEN
  UNKNOWN
}

enum ClientStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageChannel {
  SMS
  WHATSAPP
  EMAIL
  SYSTEM
}

enum MissedCallStatus {
  PENDING
  QUALIFYING
  CONVERTED
  SPAM
  EXPIRED
}

// How missed calls are rescued after the greeting.
enum MissedCallMode {
  SMS_QUALIFY
  VOICEMAIL
}

enum Channel {
  WHATSAPP
  SMS
  BOTH
}

enum EnquiryStatus {
  ROUTED
  HELD
  FAILED
}

/// Where the enquiry sits in the tradie workflow
enum EnquiryPipeline {
  INBOX
  JOB
  KILLED
  ARCHIVED
}

/// AI / heuristic pre-qualification tag for inbox triage
enum EnquiryTriage {
  LIKELY_JOB
  QUOTE_SHOPPER
  SPAM
  UNKNOWN
}

model Lead {
  id                 String         @id @default(cuid())
  placeId            String         @unique
  displayName        String
  occupation         String
  town               String
  formattedAddress   String?
  lat                Float?
  lng                Float?
  phone              String?
  phoneIsMobile      Boolean        @default(false)
  email              String?
  googleMapsUri      String?

  primaryType        String?
  editorialSummary   String?
  openingHours       String?        // JSON string[] of weekday lines
  googleReviews      Json?          // [{ author, text, rating, publishTime? }]

  websiteUri         String?
  websiteClass       WebsiteClass
  websiteCheck       WebsiteCheck   @default(SKIPPED)

  businessStatus     BizStatus      @default(UNKNOWN)
  rating             Float?
  userRatingCount    Int            @default(0)
  lastReviewAt       DateTime?
  photoCount         Int            @default(0)

  domainSuggested    String?
  domainAvailable    DomainState    @default(UNKNOWN)
  affiliateUrl       String?

  qualified          Boolean        @default(false)
  disqualifiedReason String?
  priorityScore      Int            @default(0)

  outreachStatus     OutreachStatus @default(NEW)
  tpsCheckedAt       DateTime?
  notes              String?

  siteSlug           String?
  siteGeneratedAt    DateTime?

  lastFetchedAt      DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  searchRunId        String?
  searchRun          SearchRun?     @relation(fields: [searchRunId], references: [id])

  @@index([occupation, town])
  @@index([qualified, priorityScore])
  @@index([websiteClass])
  @@index([outreachStatus])
}

model SearchRun {
  id          String     @id @default(cuid())
  occupation  String
  town        String?
  centerLat   Float?
  centerLng   Float?
  radiusM     Int?
  /// SITE_BUILD = no real website (demo site pitch). SAAS_BETA = established tradies for product beta.
  mode        SearchMode @default(SITE_BUILD)
  resultCount Int        @default(0)
  newCount    Int        @default(0)
  createdAt   DateTime   @default(now())
  leads       Lead[]
}

enum SearchMode {
  SITE_BUILD
  SAAS_BETA
}

// A converted client (the paying tradie) — the CRM tenant we route leads to.
model Client {
  id               String       @id @default(cuid())
  leadId           String?      @unique // origin prospect from the lead engine, if any — unique so a lead can't be converted twice
  businessName     String
  tradeTitle       String?
  town             String?
  addressLine1     String? // street address for invoices / business location
  addressLine2     String?
  postcode         String? // tradie's business postcode — used to compute distance to a lead's job
  vatNumber        String? // e.g. GB123456789 — shown on invoices when set
  routeKey         String       @unique // public key baked into the site/widget
  destPhone        String // tradie's own number (forwarding model), E.164 or 0-prefixed
  destChannel      Channel      @default(SMS)
  status           ClientStatus @default(ACTIVE)
  phoneVerifiedAt  DateTime?
  trialEndsAt      DateTime?
  twilioNumber     String? // dedicated Twilio number for missed-call divert
  twilioNumberSid  String? // Twilio IncomingPhoneNumber SID when auto-provisioned
  /// Setup wizard: 0 welcome … 6 get-paid; completed when onboardingCompletedAt set
  onboardingStep   Int          @default(0)
  onboardingCompletedAt DateTime?
  onboardingDivertConfirmedAt DateTime?
  onboardingTestCallAt DateTime?
  welcomeSmsSentAt DateTime?
  greetingAudioUrl String? // public URL Twilio/UI use to play the greeting
  greetingPlayToken String? @unique // /api/public/greeting/:token (survives redeploys)
  greetingAudioData Bytes? // WAV/MP3 bytes in Postgres — disk uploads are wiped on Railway redeploy
  greetingAudioMime String? // e.g. audio/wav
  missedCallMode   MissedCallMode @default(SMS_QUALIFY) // SMS Q&A vs leave a voicemail → job
  inboundEmailLocal String? @unique // local-part for inbound email intake
  bankName         String?
  bankSortCode     String?
  bankAccountName  String?
  bankAccountNumber String?
  stripeCustomerId String?
  stripeSubId      String?
  /// Stripe Connect Express account for customer invoice Pay Now
  stripeConnectAccountId String?
  stripeConnectOnboarded Boolean @default(false)
  /// Google review URL for post-job review SMS
  googleReviewUrl  String?
  /// Default deposit % on quotes (0 = off)
  defaultDepositPercent Int @default(0)
  /// Default terms text prefilled on Deposit & terms (quotes)
  defaultTermsNote String?
  /// What an hour of labour costs the business, for job profit.
  ///
  /// Null on purpose, and null is the right answer for a sole trader: he doesn't
  /// invoice himself, so charging his own time against a job would show every job
  /// at roughly zero margin and make the number worthless. Left unset, job profit
  /// reads as money in his pocket. The day someone else is on the van, set this
  /// and the same arithmetic keeps working.
  labourCostPerHourPence Int?
  allowedOrigins   String[]     @default([]) // domains permitted to POST via the widget
  tradieNotifyTpl  String? // custom message the tradie receives
  customerAckTpl   String? // custom auto-reply the customer sees
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  enquiries        Enquiry[]
  priceBookItems   PriceBookItem[]
  voiceNotes       VoiceNote[]
  quotes           Quote[]
  sessions         ClientSession[]
  assets           ClientAsset[]
  invoices         Invoice[]
  messages         Message[]
  missedCalls      MissedCall[]
  otpChallenges    OtpChallenge[]
  appointments     Appointment[]
  certificates     Certificate[]
  customerContacts CustomerContact[]
  idempotencyKeys  IdempotencyKey[]
  quoteTemplates   QuoteTemplate[]
  customers        Customer[]
  assetTypes       AssetType[]
  jobs             Job[]
  jobCosts         JobCost[]
  jobEvents        JobEvent[]
  accessReveals    AccessReveal[]

  @@index([status])
  @@index([destPhone])
  @@index([twilioNumber])
}

/// Replay guard for writes queued on a tradie's phone while they had no signal.
///
/// The offline outbox retries a request until it gets a definite answer, and a
/// request can easily succeed on the server but never make it back over a dying
/// connection. Without this, a voice note recorded in a plant room would build a
/// second draft quote on every retry. The stored response is replayed verbatim so
/// the client sees the original result, not a duplicate.
model IdempotencyKey {
  id             String   @id @default(cuid())
  key            String
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  endpoint       String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  @@unique([clientId, key])
  @@index([createdAt])
}

/// Durable CRM notes for a household/customer, keyed by normalised phone digits.
model CustomerContact {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Last 10 digits of UK mobile — stable match key across +44 / 07 formats
  phoneKey     String
  phone        String
  name         String?
  /// Freeform: access codes, preferences, history
  notes        String?
  /// Kit on site: combi model, cylinder, consumer unit, etc.
  plantNotes   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([clientId, phoneKey])
  @@index([clientId, updatedAt])
}

// ---------------------------------------------------------------------------
// Customer record
//
// Before this, a "customer" was not a record at all: the list was built by
// grouping enquiries on the last ten digits of a phone number. That made the
// phone number the identity, so a customer who changed mobile became a second
// customer, and there was nowhere to hang an address, a tenant, or a boiler.
//
// The split below is the one the wireframes are built on, and it is the whole
// point: a customer is who pays, a property is where the work happens, an asset
// is the kit being worked on. A landlord with four flats is one customer, four
// properties, and however many boilers.
// ---------------------------------------------------------------------------

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

/// How the customer prefers to be contacted.
enum ContactChannel {
  CALL
  SMS
  EMAIL
  WHATSAPP
}

model Customer {
  id                 String         @id @default(cuid())
  clientId           String
  client             Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type               CustomerType   @default(INDIVIDUAL)
  /// Person or company name — what shows at the top of the record.
  name               String
  phone              String?
  /// Legacy match key. Kept so old /t/customers/:phoneKey links and the enquiry
  /// grouping still resolve while everything moves across to real ids.
  phoneKey           String?
  email              String?
  preferredChannel   ContactChannel @default(CALL)
  billingAddress     String?
  billingPostcode    String?
  /// Free chips: Preferred, Long term, Trade …
  tags               String[]       @default([])
  paymentTerms       String?
  /// Carried over from the old free-text customer notes.
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  contacts           Contact[]
  properties         Property[]
  files              CustomerFile[]
  customerNotes      CustomerNote[]
  reminders          Reminder[]
  enquiries          Enquiry[]
  invoices           Invoice[]
  jobs               Job[]
  /// Properties billed to this customer but owned by another record.
  billedProperties   Property[]     @relation("PropertyBillTo")

  @@unique([clientId, phoneKey])
  @@index([clientId, name])
}

enum ContactRole {
  OWNER
  TENANT
  SITE_CONTACT
  ACCOUNTS
  PROPERTY_MANAGER
}

model Contact {
  id                   String      @id @default(cuid())
  clientId             String
  customerId           String
  customer             Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name                 String
  role                 ContactRole @default(OWNER)
  phone                String?
  email                String?
  /// Exactly one per customer should be primary — enforced in the service layer,
  /// not the schema, because setting a new primary has to clear the old one and a
  /// partial unique index would reject the intermediate state.
  isPrimary            Boolean     @default(false)
  receivesQuotes       Boolean     @default(true)
  receivesInvoices     Boolean     @default(true)
  receivesAppointments Boolean     @default(true)
  notes                String?
  sort                 Int         @default(0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  siteFor              Property[]  @relation("PropertySiteContact")
  siteForJobs          Job[]       @relation("JobSiteContact")

  @@index([customerId, sort])
}

enum Occupancy {
  OWNER_OCCUPIED
  TENANTED
  EMPTY
}

model Property {
  id                String          @id @default(cuid())
  clientId          String
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// "Main Home", "Riverside Flat" — what the tradie calls it.
  nickname          String?
  addressLine1      String?
  addressLine2      String?
  town              String?
  postcode          String?
  propertyType      String?
  occupancy         Occupancy?
  siteContactId     String?
  siteContact       Contact?        @relation("PropertySiteContact", fields: [siteContactId], references: [id], onDelete: SetNull)
  /// Bill someone other than the owner — a managing agent, say.
  billToCustomerId  String?
  billToCustomer    Customer?       @relation("PropertyBillTo", fields: [billToCustomerId], references: [id], onDelete: SetNull)
  sort              Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  access            PropertyAccess?
  assets            Asset[]
  enquiries         Enquiry[]
  files             CustomerFile[]
  propertyNotes     CustomerNote[]
  reminders         Reminder[]
  jobs              Job[]
  accessReveals     AccessReveal[]

  @@index([customerId, sort])
  @@index([clientId, postcode])
}

/// Structured access and safety for one property.
///
/// Split from Property deliberately: this is the sensitive half. Access codes and
/// key-safe locations are the keys to a stranger's house, and keeping them in
/// their own row means they can be masked, permissioned and — once staff logins
/// exist — audited, without dragging the whole property record along.
model PropertyAccess {
  id                String   @id @default(cuid())
  clientId          String
  propertyId        String   @unique
  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Key safe / Meet on site / Tenant lets in …
  accessMethod      String?
  keySafe           Boolean  @default(false)
  keySafeLocation   String?
  /// Sensitive — masked in the UI until deliberately revealed.
  accessCode        String?
  alarm             Boolean  @default(false)
  parking           String?
  permitRequired    Boolean  @default(false)
  /// "08:00" / "17:00" — stored as text because they're display hints, not instants.
  workingHoursFrom  String?
  workingHoursTo    String?
  callBeforeArrival Boolean  @default(false)
  dogOnSite         Boolean  @default(false)
  asbestosKnown     Boolean  @default(false)
  /// Asbestos, Confined space, Gas …
  safetyFlags       String[] @default([])
  /// Internal only — never shown to the customer.
  engineerNotes     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// The catalogue of asset types a tradie can pick from.
///
/// A fixed enum was the wrong shape here. UK trades don't share a vocabulary —
/// a gas engineer services unvented cylinders and flues, a sparky inspects
/// consumer units and EV chargers, a roofer records a covering with a warranty on
/// it — and no list written up front survives contact with the next trade that
/// signs up. So each account gets a researched starter set for its trade, seeded
/// on first use exactly like the price book, and adds its own from there.
model AssetType {
  id                   String   @id @default(cuid())
  clientId             String
  client               Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label                String
  /// Picker grouping: HEATING | WATER | ELECTRICAL | RENEWABLE | FABRIC | OTHER
  group                String   @default("OTHER")
  /// Typical service/inspection interval, in months. An unvented cylinder is 12,
  /// a domestic EICR is 120. Seeds the next-due date so a reminder exists without
  /// the tradie doing the arithmetic on a doorstep.
  defaultServiceMonths Int?
  /// Seeded types are hidden rather than deleted — a plumber who never touches
  /// LPG shouldn't have to scroll past it, but assets already filed under it must
  /// keep their label.
  active               Boolean  @default(true)
  sort                 Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([clientId, label])
  @@index([clientId, active, sort])
}

/// A piece of kit at a property. Replaces the free-text "plant notes" box.
///
/// The service dates are the commercial point: a boiler with a next-due date is
/// next year's work already on the books.
model Asset {
  id            String         @id @default(cuid())
  clientId      String
  propertyId    String
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// The AssetType label, stored on the row rather than referenced. An asset must
  /// keep saying "Unvented cylinder" even if that type is later renamed or hidden.
  kind          String         @default("Other")
  name          String?
  manufacturer  String?
  model         String?
  serial        String?
  installDate   DateTime?
  /// Where in the property — "Kitchen cupboard", "Loft".
  location      String?
  warrantyUntil DateTime?
  lastServiceAt DateTime?
  nextDueAt     DateTime?
  notes         String?
  sort          Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  files         CustomerFile[]
  assetNotes    CustomerNote[]
  reminders     Reminder[]

  @@index([propertyId, sort])
  @@index([clientId, nextDueAt])
}

enum FileCategory {
  CERTIFICATE
  MANUAL
  WARRANTY
  PHOTO
  INVOICE
  OTHER
}

/// Internal by default. Costs, engineer notes and access details must never leak
/// to a customer just because someone attached them to the wrong record.
enum RecordVisibility {
  INTERNAL
  CUSTOMER
}

model CustomerFile {
  id          String           @id @default(cuid())
  clientId    String
  customerId  String?
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  propertyId  String?
  property    Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assetId     String?
  asset       Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  enquiryId   String?
  enquiry     Enquiry?         @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  jobId       String?
  job         Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  category    FileCategory     @default(OTHER)
  filename    String
  url         String
  contentType String?
  sizeBytes   Int?
  issuedAt    DateTime?
  /// Drives the expiry reminder — a gas cert that lapses is a job.
  expiresAt   DateTime?
  visibility  RecordVisibility @default(INTERNAL)
  createdAt   DateTime         @default(now())

  /// Receipts attached to a cost line — the merchant docket behind "paid £1,012".
  receiptFor  JobCost[]        @relation("JobCostReceipt")

  @@index([clientId, customerId, createdAt])
  @@index([clientId, expiresAt])
  @@index([clientId, jobId, createdAt])
}

enum NoteType {
  CUSTOMER
  PROPERTY
  JOB
  PRIVATE
}

model CustomerNote {
  id         String           @id @default(cuid())
  clientId   String
  customerId String?
  customer   Customer?        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assetId    String?
  asset      Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  enquiryId  String?
  enquiry    Enquiry?         @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  jobId      String?
  job        Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  type       NoteType         @default(CUSTOMER)
  body       String
  pinned     Boolean          @default(false)
  visibility RecordVisibility @default(INTERNAL)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([clientId, customerId, createdAt])
}

/// Service dates, certificate expiries and inspections — the repeat-business engine.
model Reminder {
  id          String    @id @default(cuid())
  clientId    String
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assetId     String?
  asset       Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  /// ANNUAL_SERVICE | CERT_EXPIRY | INSPECTION | OTHER
  kind        String    @default("OTHER")
  label       String
  dueAt       DateTime
  /// Repeat interval; null for one-offs.
  everyMonths Int?
  active      Boolean   @default(true)
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId, active, dueAt])
}

enum TwilioPoolStatus {
  AVAILABLE
  ASSIGNED
}

/// Spare / inventory Twilio numbers — claim before buying a new one.
model TwilioNumberPool {
  id               String           @id @default(cuid())
  phoneNumber      String           @unique
  sid              String           @unique
  status           TwilioPoolStatus @default(AVAILABLE)
  assignedClientId String?          @unique
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
}

// A routed customer enquiry (the actual lead delivered to a client).
model Enquiry {
  id           String          @id @default(cuid())
  clientId     String
  client       Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  /// Optional — lets a quote be emailed as well as texted.
  email        String?
  message      String?
  postcode     String? // customer's job postcode, if given
  distanceMiles Float? // computed distance from client.postcode, if both are known
  photoUrls    String[]        @default([])
  source       String          @default("site") // site | widget | hosted | qr | missed_call | manual
  status       EnquiryStatus   @default(ROUTED)
  pipeline     EnquiryPipeline @default(INBOX)
  triage       EnquiryTriage   @default(UNKNOWN)
  /// Short AI / qualify summary shown in Inbox
  summary      String?
  promotedAt   DateTime?
  killedAt     DateTime?
  deliveredAt  DateTime?
  deliveryInfo String?
  createdAt    DateTime        @default(now())

  /// Nullable on purpose. An enquiry arrives from a stranger off the website
  /// before anyone has decided they're a customer, so the link is made when the
  /// record is created — not required at the door.
  customerId   String?
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  propertyId   String?
  property     Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  quotes       Quote[]
  voiceNotes   VoiceNote[]
  invoices     Invoice[]
  messages     Message[]
  missedCalls  MissedCall[]
  appointments Appointment[]
  certificates Certificate[]
  files        CustomerFile[]
  notes        CustomerNote[]
  jobs         Job[]

  @@index([clientId, createdAt])
  @@index([clientId, phone])
  @@index([clientId, pipeline, createdAt])
  @@index([clientId, customerId])
}

/// Where the work has got to on the ground.
enum JobOperational {
  UNSCHEDULED
  SCHEDULED
  ON_THE_WAY
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

/// Where the money has got to. Deliberately separate from JobOperational.
///
/// One badge cannot say both, and trying made a job that was finished last Tuesday
/// but never billed look identical to one quoted this morning and not started. That
/// is unbilled work made invisible, which is the most expensive bug in a trade app.
enum JobCommercial {
  UNQUOTED
  QUOTED
  DEPOSIT_DUE
  DEPOSIT_PAID
  READY_TO_INVOICE
  INVOICE_SENT
  PAID
}

/// The operational container for agreed work.
///
/// Before this existed a "job" was an Enquiry row with pipeline flipped to JOB, and
/// its status was read off whichever quote happened to be newest — which is why a
/// DECLINED quote could show up as a job state. A job now owns its own two states.
model Job {
  id               String         @id @default(cuid())
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// The enquiry this came from, kept for provenance. Null for a job booked direct.
  enquiryId        String?
  enquiry          Enquiry?       @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  /// The accepted commercial baseline. Never mutated once work starts — extras are
  /// JobCost rows, so the original agreed price stays auditable.
  quoteId          String?
  quote            Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  customerId       String?
  customer         Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  propertyId       String?
  property         Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  siteContactId    String?
  siteContact      Contact?       @relation("JobSiteContact", fields: [siteContactId], references: [id], onDelete: SetNull)
  /// Human-facing ref — "J-1042". Assigned per client.
  reference        String?
  title            String
  scope            String?
  operational      JobOperational @default(UNSCHEDULED)
  /// UNQUOTED by default because a call-out has no quote. The PRD's list starts at
  /// QUOTED and has no state for the emergency-leak path it also specifies.
  commercial       JobCommercial  @default(UNQUOTED)
  /// Ex-VAT accepted total. VAT is not the tradie's money and must not reach profit.
  quotedTotalPence Int            @default(0)
  depositPaidPence Int            @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  visits           Appointment[]
  costs            JobCost[]
  events           JobEvent[]
  files            CustomerFile[]
  notes            CustomerNote[]
  accessReveals    AccessReveal[]

  @@index([clientId, operational, createdAt])
  @@index([clientId, commercial, createdAt])
  @@index([clientId, archivedAt])
  @@index([customerId])
  @@index([propertyId])
  @@index([quoteId])
  @@index([enquiryId])
}

enum JobCostType {
  MATERIAL
  LABOUR
  EXPENSE
  SUBCONTRACTOR
}

/// What a job actually cost, and what it's charged out at.
///
/// Both numbers on one row on purpose: the gap between them is the job's profit,
/// and splitting them across tables would mean joining to answer the only question
/// anyone asks of this data.
model JobCost {
  id              String      @id @default(cuid())
  clientId        String
  client          Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  jobId           String
  job             Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type            JobCostType @default(MATERIAL)
  label           String
  qty             Float       @default(1)
  unit            PriceUnit   @default(JOB)
  /// What it cost the tradie. Null means "not set yet", which is not the same as
  /// zero — zero is a real answer (own labour, a part the customer supplied).
  /// Collapsing the two would let an unpriced material read as pure profit, which
  /// is the one wrong number this feature must never show.
  unitCostPence   Int?
  /// What the customer is charged, ex VAT.
  sellPricePence  Int         @default(0)
  vatRate         Float       @default(20)
  billable        Boolean     @default(true)
  priceBookItemId String?
  priceBookItem   PriceBookItem? @relation(fields: [priceBookItemId], references: [id], onDelete: SetNull)
  /// Work beyond the accepted quote. This plus agreedAt is the whole of
  /// "variations" — recording that the customer said yes is the part with value;
  /// a Draft/Sent/Approved/Declined state machine is one nobody would drive.
  isExtra         Boolean     @default(false)
  agreedAt        DateTime?
  /// phone | in person | message
  agreedVia       String?
  receiptFileId   String?
  receiptFile     CustomerFile? @relation("JobCostReceipt", fields: [receiptFileId], references: [id], onDelete: SetNull)
  invoicedAt      DateTime?
  /// QUOTE | BOOK | MANUAL — where the line came from.
  source          String      @default("MANUAL")
  sort            Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([jobId, sort])
  @@index([clientId, invoicedAt])
}

/// Job history, stored rather than derived.
///
/// This reverses the call made for the customer timeline, and the reason matters:
/// job history is commercially meaningful — when you arrived, when the customer
/// approved the extra, when it was signed off. A derived timeline that quietly
/// changes when an underlying record is edited is worse than none if a job is ever
/// disputed. Customer activity stays derived; this does not.
model JobEvent {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// job.created, job.scheduled, visit.on_my_way, job.started, job.completed,
  /// cost.added, cost.extra_agreed, invoice.created, invoice.paid, access.revealed
  type      String
  summary   String
  payload   Json?
  /// Account holder for now; a real user id once staff logins exist.
  actor     String?
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
}

/// Who looked at a property's access code, and when.
///
/// Its own table rather than a JobEvent because a code can be revealed from the
/// property record with no job in sight. Written from day one even though there is
/// currently one user per account, so the history isn't starting from zero on the
/// day engineer logins ship — which is the day it starts to matter.
model AccessReveal {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  jobId      String?
  job        Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  actorLabel String
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([propertyId, createdAt])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  DELETED
  ARCHIVED
}

enum VoiceNoteStatus {
  UPLOADED
  TRANSCRIBING
  READY
  FAILED
}

enum FollowUpKind {
  QUOTE_D2
  QUOTE_D5
  QUOTE_D10
  INVOICE_D3
  INVOICE_D7
  REVIEW_ASK
  REVIEW_NUDGE
  APPT_CONFIRM
  APPT_REMINDER
  SERVICE_REMINDER
}

enum FollowUpStatus {
  PENDING
  SENT
  SKIPPED
  CANCELLED
}

enum PriceUnit {
  EACH
  HOUR
  DAY
  JOB
  METRE
}

model PriceBookItem {
  id             String    @id @default(cuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sku            String?
  label          String
  tradeTag       String?
  /// SERVICE | MATERIAL | LABOUR | CALLOUT | OTHER — groups the price book.
  category       String?
  unit           PriceUnit @default(JOB)
  unitPricePence Int
  /// What this costs the tradie, for job profit. Nullable, and stays nullable.
  ///
  /// An item with no cost must read as "cost not set", never as 100% margin — a
  /// confidently wrong profit figure is worse than an absent one, because it's the
  /// one a tradie would act on.
  costPricePence Int?
  vatRate        Float     @default(20)
  isCallout      Boolean   @default(false)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  quoteLines     QuoteLine[]
  jobCosts       JobCost[]

  @@index([clientId, active])
}

model VoiceNote {
  id          String          @id @default(cuid())
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  enquiryId   String?
  enquiry     Enquiry?        @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  audioUrl    String?
  transcript  String?
  status      VoiceNoteStatus @default(UPLOADED)
  durationSec Int?
  rawExtract  Json?
  error       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  quotes      Quote[]

  @@index([clientId, createdAt])
  @@index([enquiryId])
}

model Quote {
  id              String      @id @default(cuid())
  clientId        String
  client          Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  enquiryId       String?
  enquiry         Enquiry?    @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  voiceNoteId     String?
  voiceNote       VoiceNote?  @relation(fields: [voiceNoteId], references: [id], onDelete: SetNull)
  status          QuoteStatus @default(DRAFT)
  /// Set when status becomes ARCHIVED so we can restore on unarchive
  statusBeforeArchive QuoteStatus?
  currency        String      @default("GBP")
  vatInclusive    Boolean     @default(true)
  subtotalPence   Int         @default(0)
  vatPence        Int         @default(0)
  totalPence      Int         @default(0)
  /// 0-100; deposit required on accept when > 0 and Connect ready
  depositPercent  Int         @default(0)
  depositPence    Int         @default(0)
  depositPaidAt   DateTime?
  depositStripeSessionId String?
  publicToken     String      @unique
  customerNote    String?
  assumptions     String?
  pdfUrl          String?
  sentAt          DateTime?
  decidedAt       DateTime?
  validUntil      DateTime?
  /// Human-facing ref shown on the quote — "Q-1052". Assigned per client.
  reference       String?
  /// How long the quote stands, in days. Drives validUntil when sent.
  validDays       Int         @default(30)
  /// Availability the tradie promised — shown to the customer, not scheduled.
  earliestStartAt DateTime?
  estimatedDuration String?
  /// Free text terms shown under the totals ("Payment on completion…").
  termsNote       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  lines           QuoteLine[]
  followUps       FollowUp[]
  invoices        Invoice[]
  jobs            Job[]

  @@index([clientId, status, createdAt])
  @@index([enquiryId])
}

/// A reusable bundle of priced lines for a job the tradie does often.
///
/// Seeded per trade so a new account has something useful on day one, then edited
/// freely. Distinct from the price book: that's individual rates, this is "a boiler
/// install is these 18 things".
model QuoteTemplate {
  id          String              @id @default(cuid())
  clientId    String
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  /// Groups the filter chips on the browse screen — "Heating", "Bathrooms".
  category    String?
  description String?
  /// Free labels the tradie picks — "Common job", "Emergency", "Service", "Install".
  tags        String[]            @default([])
  /// Rough time on the job, shown when quoting. Minutes so it survives "01:30".
  defaultDurationMins Int?
  /// Whether this template may be suggested when drafting from notes or voice.
  /// Stored now; the drafting side doesn't read it yet.
  useForAiDrafting Boolean        @default(true)
  vatRate     Int                 @default(20)
  /// Optional default deposit for quotes built from this template.
  depositPercent Int?
  /// Exclusions and caveats carried onto the quote.
  notes       String?
  /// Bumped whenever a quote is started from this template, to order "Recent".
  lastUsedAt  DateTime?
  useCount    Int                 @default(0)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  items       QuoteTemplateItem[]

  @@index([clientId, active, name])
  @@index([clientId, lastUsedAt])
}

model QuoteTemplateItem {
  id              String        @id @default(cuid())
  templateId      String
  template        QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label           String
  qty             Float         @default(1)
  unit            String        @default("JOB")
  unitPricePence  Int           @default(0)
  vatRate         Int           @default(20)
  /// Optional extras the tradie ticks on the template screen rather than getting
  /// by default — "Smart thermostat +£150".
  isAddOn         Boolean       @default(false)
  sortOrder       Int           @default(0)
  /// Kept in step with the price book where it came from, so rate changes flow through.
  priceBookItemId String?

  @@index([templateId, isAddOn, sortOrder])
}

model QuoteLine {
  id              String         @id @default(cuid())
  quoteId         String
  quote           Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sort            Int            @default(0)
  label           String
  qty             Float          @default(1)
  unit            PriceUnit      @default(JOB)
  unitPricePence  Int
  /// Cost snapshotted when the line was priced.
  ///
  /// Copied off the price book rather than read through it, because merchant prices
  /// move. The margin worth seeing is the one expected when the job was priced, not
  /// one that silently rewrites itself when copper goes up in June.
  costPricePence  Int?
  vatRate         Float          @default(20)
  priceBookItemId String?
  priceBookItem   PriceBookItem? @relation(fields: [priceBookItemId], references: [id], onDelete: SetNull)
  source          String         @default("MANUAL") // VOICE | BOOK | MANUAL
  createdAt       DateTime       @default(now())

  @@index([quoteId])
}

model FollowUp {
  id             String         @id @default(cuid())
  quoteId        String?
  quote          Quote?         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  invoiceId      String?
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  appointmentId  String?
  appointment    Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  certificateId  String?
  certificate    Certificate?   @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  clientId       String?
  enquiryId      String?
  kind           FollowUpKind
  status         FollowUpStatus @default(PENDING)
  runAt          DateTime
  sentAt         DateTime?
  bodySnapshot   String?
  createdAt      DateTime       @default(now())

  @@index([status, runAt])
  @@index([quoteId])
  @@index([invoiceId])
  @@index([appointmentId])
  @@index([certificateId])
}

model ClientSession {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([clientId])
  @@index([expiresAt])
}

enum ClientAssetKind {
  LOGO
  SHOWCASE
  JOB
  OTHER
}

/// Brand + portfolio images for website generation and quotes.
model ClientAsset {
  id        String          @id @default(cuid())
  clientId  String
  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind      ClientAssetKind @default(SHOWCASE)
  url       String
  filename  String?
  caption   String?
  sort      Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([clientId, kind])
}

model Invoice {
  id                String        @id @default(cuid())
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  enquiryId         String?
  enquiry           Enquiry?      @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  quoteId           String?
  quote             Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  /// Who is actually billed. Set from the property's billTo where one exists, so a
  /// managing agent's invoices don't file under the tenant.
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status            InvoiceStatus @default(DRAFT)
  publicToken       String        @unique
  customerName      String?
  customerPhone     String?
  currency          String        @default("GBP")
  vatInclusive      Boolean       @default(true)
  subtotalPence     Int           @default(0)
  vatPence          Int           @default(0)
  totalPence        Int           @default(0)
  /// Amount still due after deposits already collected
  amountDuePence    Int           @default(0)
  depositAppliedPence Int         @default(0)
  dueDate           DateTime?
  reference         String?
  bankName          String?
  bankSortCode      String?
  bankAccountName   String?
  bankAccountNumber String?
  customerNote      String?
  pdfUrl            String?
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidVia           String? // bank | stripe | manual
  sentAt            DateTime?
  paidAt            DateTime?
  paidReportedAt    DateTime?
  reviewAskedAt     DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  lines             InvoiceLine[]
  followUps         FollowUp[]

  @@index([clientId, status, createdAt])
  @@index([enquiryId])
  @@index([quoteId])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sort           Int     @default(0)
  label          String
  qty            Float   @default(1)
  unit           String  @default("JOB")
  unitPricePence Int
  vatRate        Float   @default(20)
  createdAt      DateTime @default(now())

  @@index([invoiceId])
}

model Message {
  id          String           @id @default(cuid())
  clientId    String
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  enquiryId   String?
  enquiry     Enquiry?         @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  direction   MessageDirection
  channel     MessageChannel   @default(SMS)
  toAddr      String
  fromAddr    String?
  body        String
  twilioSid   String?
  status      String           @default("sent")
  createdAt   DateTime         @default(now())

  @@index([clientId, createdAt])
  @@index([enquiryId, createdAt])
  @@index([toAddr])
}

model MissedCall {
  id            String          @id @default(cuid())
  clientId      String
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  callerPhone   String
  status        MissedCallStatus @default(PENDING)
  enquiryId     String?
  enquiry       Enquiry?        @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  conversation  Json?           // [{role, text, at}]
  callSid       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([clientId, callerPhone, status])
  @@index([callerPhone, status])
}

model OtpChallenge {
  id         String   @id @default(cuid())
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  phone      String
  codeHash   String
  purpose    String   // signup | login
  payload    Json?    // signup draft fields before client exists
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
}

enum EarlyAccessStatus {
  PENDING
  APPROVED
  DENIED
}

model EarlyAccessRequest {
  id              String            @id @default(cuid())
  email           String
  phone           String
  occupation      String
  status          EarlyAccessStatus @default(PENDING)
  inviteTokenHash String?           @unique
  inviteExpiresAt DateTime?
  inviteSentAt    DateTime?
  inviteUsedAt    DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([phone])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ON_THE_WAY
  DONE
  CANCELLED
  NO_SHOW
}

/// An appointment is also the job's visit.
///
/// The PRD models Visit as a separate entity, but this table already carries
/// start/end, ON_THE_WAY and the whole Diary. Making the visit a second record
/// pointing at the same slot would mean two sources of truth for "when am I
/// there", kept in sync by hand. Extending this instead means scheduling a visit
/// *is* creating the diary entry — there is nothing left to drift.
model Appointment {
  id          String            @id @default(cuid())
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  enquiryId   String?
  enquiry     Enquiry?          @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  jobId       String?
  job         Job?              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  /// Survey | First fix | Return with part | Final | Service — free text, shown as
  /// a chip once a job has more than one visit.
  kind        String?
  startsAt    DateTime
  endsAt      DateTime
  /// What the customer was told — "between 9 and 11" — as opposed to the slot the
  /// tradie blocked out. Nullable: most jobs are booked to a time, not a window.
  arrivalWindowStart DateTime?
  arrivalWindowEnd   DateTime?
  status      AppointmentStatus @default(SCHEDULED)
  completedAt DateTime?
  address     String?
  customerName String?
  customerPhone String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  followUps   FollowUp[]

  @@index([clientId, startsAt])
  @@index([enquiryId])
  @@index([jobId, startsAt])
}

enum CertificateKind {
  GAS_SAFETY
  MINOR_WORKS
  EICR
  OTHER
}

enum CertificateStatus {
  DRAFT
  SIGNED
  FILED
  SENT
}

model Certificate {
  id              String            @id @default(cuid())
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  enquiryId       String?
  enquiry         Enquiry?          @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  kind            CertificateKind
  status          CertificateStatus @default(DRAFT)
  siteAddress     String?
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  /// Optional notes / legacy form fields
  formData        Json              @default("{}")
  /// Date the real certificate was issued / work done
  issuedAt        DateTime?
  /// Gas Safe / scheme / engineer reference (free text)
  schemeRef       String?
  signatureDataUrl String?
  signedAt        DateTime?
  /// Uploaded photo or PDF of the real certificate (also used for legacy generated PDFs)
  pdfUrl          String?
  fileContentType String?
  publicToken     String            @unique
  /// Reminder date (typically ~11 months / expiry)
  serviceDueAt    DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  followUps       FollowUp[]

  @@index([clientId, kind, createdAt])
  @@index([enquiryId])
  @@index([serviceDueAt])
}

/// Platform key/value config (survives Railway redeploys; env still wins when set).
model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
